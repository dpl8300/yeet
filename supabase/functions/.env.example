# Custom Edge Function setting. Copy to supabase/functions/.env for local Supabase.
# Use origins only (no paths or trailing slashes); comma-separated wildcards are supported.
WEB_ALLOWED_ORIGINS=http://localhost:5173,https://yeet.example,https://*-your-team.vercel.app

# Do not add SUPABASE_URL, SUPABASE_SECRET_KEYS, or SUPABASE_SERVICE_ROLE_KEY here
# for hosted functions. Supabase injects them automatically. Never put an elevated
# Supabase key in apps/web, a VITE_ variable, or Vercel.
