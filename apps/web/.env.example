# Browser-safe Vite values only. Copy this file to apps/web/.env.local.
# Never place a Supabase secret key or legacy service_role key in a VITE_ variable.

# Supabase Dashboard -> Connect, or Settings -> API Keys -> Project URL.
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Dashboard -> Connect, or Settings -> API Keys -> Publishable key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
